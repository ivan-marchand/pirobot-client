      {
        "type": "drive",
        "action": "stop"
      }
    ]
  },
  "patrol": {
    "group": "robot",
    "commands": [
      {
        "type": "drive",
        "action": "patrol"
      },
      {
        "type": "lcd",
        "action": "display_picture",
        "args": {
          "name": "patrol"
        }
      }
    ]
  },
